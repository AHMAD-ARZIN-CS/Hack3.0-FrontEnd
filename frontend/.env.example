# Copy to .env.local and adjust. Never commit .env.local or real secrets.
# Every NEXT_PUBLIC_ value is visible in the browser. Put nothing private here.

# Where app data comes from: mock | api
NEXT_PUBLIC_DATA_MODE=mock

# Where sign-in comes from: demo | backend
# Leave unset to follow DATA_MODE (mock → demo, api → backend).
# Tip: connect auth first with AUTH_MODE=backend while DATA_MODE is still mock.
NEXT_PUBLIC_AUTH_MODE=demo

# Backend base URL, e.g. http://localhost:4000/api or https://api.example.com/v1 (empty in mock mode)
NEXT_PUBLIC_API_URL=

# Default campus before the student picks one: chabot | dvc | csueb
NEXT_PUBLIC_CAMPUS=chabot

# Only if the team connects Firebase directly from the browser (Q6). These web-app values are
# public by design; security comes from Firebase Security Rules, not from hiding them.
# Never put a service-account key or admin credential in this file.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_APP_ID=
